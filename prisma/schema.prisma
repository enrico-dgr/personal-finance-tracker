generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  merchantRules MerchantRule[]
}

/// Deprecated by ADR-0002: transaction history is session-only and this table is
/// never written to. Kept in the schema so an existing local dev.db stays readable;
/// see ADR-0003 for the conditions under which it gets dropped.
model Transaction {
  id                    String   @id @default(cuid())
  fingerprint           String   @unique
  date                  DateTime
  originalDescription   String
  normalizedDescription String
  amount                Float
  category              String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MerchantRule {
  id             String   @id @default(cuid())
  userId         String?
  defaultRuleId  String?
  pattern        String
  patternType    String   @default("contains")
  normalizedName String
  category       String
  priority       Int      @default(1000)
  isDisabled     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, defaultRuleId])
}
