{
  "name": "personal-finance-tracker",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace apps/api\" \"npm run dev --workspace apps/web\"",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "test:api": "npm run test --workspace apps/api",
    "test:web": "npm run test --workspace apps/web",
    "test": "npm run test:api && npm run test:web",
    "lint": "eslint .",
    "prisma": "prisma",
    "prisma:help": "prisma --help",
    "contract:emit": "prisma contract emit",
    "migration:plan": "prisma migration plan",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:seed": "tsx apps/api/src/prisma/seed.ts",
    "compute:login": "prisma auth login",
    "compute:database:create": "prisma postgres create prisma-compute-nextjs --branch main",
    "compute:connect": "prisma git connect",
    "compute:open": "prisma service open",
    "postinstall": "prisma skills sync || exit 0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.2.3",
    "@types/node": "^22.20.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "prisma": "^8.0.0-rc.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/orm-extension-pgvector": "^8.0.0-rc.9",
    "@prisma/orm-postgres": "^8.0.0-rc.9",
    "dotenv": "^17.4.2"
  }
}
